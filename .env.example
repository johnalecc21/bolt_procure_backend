DATABASE_URL="postgresql://postgres.<project-ref>:<db-password>@<pooler-host>:5432/postgres"
SUPABASE_URL="https://<project-ref>.supabase.co"
SUPABASE_ANON_KEY="<anon-key>"
SUPABASE_SERVICE_ROLE_KEY="<service-role-key>"
PORT=3001
# Uno o varios orígenes separados por comas; el primero es la URL pública.
CORS_ORIGIN="http://localhost:5173"
REDIS_URL="redis://localhost:6379"
GLITCHTIP_DSN=<glitchtip-project-dsn>
# Commit desplegado, para que cada error en GlitchTip diga de qué versión viene (opcional).
GIT_SHA=
LOKI_HOST="http://localhost:3100"
LOKI_USER=
LOKI_PASSWORD=

# Correos transaccionales (Resend). Sin la llave, los correos solo se registran en el log.
RESEND_API_KEY=
EMAIL_FROM="Procurex <notificaciones@tudominio.com>"
# URL pública del frontend para los enlaces de los correos (por defecto CORS_ORIGIN)
APP_URL=http://localhost:5173
