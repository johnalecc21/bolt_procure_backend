generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum Portal {
  CLIENTE
  PROVEEDOR
  INTERNO
}

enum Role {
  COMPRADOR
  APROBADOR_CFO
  ADMIN_CLIENTE
  PROVEEDOR
  CONSULTOR
  COMPLIANCE_OPS
}

enum EstadoRequerimiento {
  BORRADOR
  PENDIENTE_APROBACION
  EN_LICITACION
  EN_NEGOCIACION
  ADJUDICADO
  EN_CUMPLIMIENTO
  CERRADO
}

enum EstadoHomologacion {
  BORRADOR
  EN_REVISION
  APROBADO
  RECHAZADO
  ZONA_GRIS
}

/// Nivel de riesgo del modelo de homologación basado en riesgo (score ponderado
/// por 6 categorías). Determina la cadena de aprobación requerida y la
/// periodicidad de reevaluación — ver HomologacionScoringService.NIVEL_RIESGO_INFO.
enum NivelRiesgo {
  BAJO
  MEDIO
  ALTO
  CRITICO
}

enum EstadoDocumento {
  PENDIENTE
  SUBIDO
  VALIDADO
  VENCIDO
}

enum CategoriaDocumento {
  LEGAL
  FINANCIERO
  CERTIFICACIONES
  REFERENCIAS
  HSE
  SOSTENIBILIDAD
  RIESGO_FINANCIERO
  LAFT
}

enum Moneda {
  COP
  USD
  MXN
  PEN
  CLP
  BRL
}

enum TipoArchivoVitrina {
  IMAGEN
  BROCHURE
  CATALOGO
}

enum ResultadoLista {
  SIN_COINCIDENCIA
  COINCIDENCIA
  NO_DISPONIBLE
  PENDIENTE_MANUAL
}

enum TipoContrato {
  CONTRATO
  PO
  ADDENDUM
}

enum EstadoContrato {
  ACTIVO
  POR_VENCER
  VENCIDO
  EN_RENOVACION
  // Ended early by the buyer (see ModificacionContrato TERMINACION).
  TERMINADO
}

enum TipoModificacion {
  PRORROGA
  MONTO
  TERMINACION
}

enum TipoAprobacion {
  SALIDA_LICITACION
  ADJUDICACION
  EXCEPCION_PRESUPUESTO
}

enum EstadoAprobacion {
  PENDIENTE
  APROBADA
  RECHAZADA
}

enum TipoRegla {
  UNICA
  SECUENCIAL
}

enum EstadoHito {
  COMPLETADO
  EN_RIESGO
  ATRASADO
  PENDIENTE
}

enum Severidad {
  BAJA
  MEDIA
  ALTA
}

enum EstadoDisputa {
  ABIERTA
  EN_MEDIACION
  RESUELTA
}

enum EstadoInvitacion {
  NUEVA
  VISTA
  RESPONDIDA
  VENCIDA
  DECLINADA
}

enum EstadoPago {
  PENDIENTE
  PAGADO
  VENCIDO
}

enum EstadoFactura {
  RADICADA
  APROBADA
  RECHAZADA
}

enum EstadoProntoPago {
  SOLICITADA
  ACEPTADA
  RECHAZADA
}

enum PrioridadRequerimiento {
  NORMAL
  ALTA
  URGENTE
}

enum TipoNotificacion {
  APROBACION
  OFERTA
  CONTRATO
  NEGOCIACION
  PROVEEDOR
  DISPUTA
}

enum EstadoCaso {
  PENDIENTE
  EN_PROGRESO
  ESCALADO
}

enum Prioridad {
  BAJA
  MEDIA
  ALTA
}

enum PlanCliente {
  STARTER
  GROWTH
  ENTERPRISE
}

enum EstadoFacturacion {
  AL_DIA
  PENDIENTE
  VENCIDA
}

enum EstadoSubasta {
  INACTIVA
  ACTIVA
  CERRADA
}

// ---------------------------------------------------------------------------
// Identity / tenancy
// ---------------------------------------------------------------------------

model Company {
  id                               String               @id @default(cuid())
  nombre                           String
  plan                             PlanCliente          @default(STARTER)
  facturacion                      EstadoFacturacion    @default(AL_DIA)
  createdAt                        DateTime             @default(now())
  // Adjudicaciones at or above this amount generate a Contrato Marco instead
  // of a simple PO — independent from the "revisión legal" threshold, since
  // a company may want legal review earlier (or later) than it wants a
  // formal master contract.
  umbralContratoMarco              Int                  @default(50000)
  // ISO-3166 alpha-2 — drives which tax id / restrictive lists apply.
  pais                             String               @default("CO")
  /// When on, suppliers who lost a process see their price rank and their gap
  /// to the awarded price (never the winner's name or other bids).
  feedbackCompetitivo              Boolean              @default(false)
  // Default currency for new requerimientos; analytics aggregate only in it.
  monedaBase                       Moneda               @default(USD)
  // Document categories a proveedor must have VALIDADO (and not expired) to
  // be invited by this company, on top of an APROBADO homologación. Empty
  // (the default) keeps the original rule: APROBADO is enough.
  categoriasHomologacionRequeridas CategoriaDocumento[] @default([])
  // When true, every new requerimiento must be charged to a centro de costo.
  exigeCentroCosto                 Boolean              @default(false)
  // Audit rows older than this are purged by the daily retention job.
  // Default 10 years — Colombian commercial books (Código de Comercio art. 60).
  retencionAuditoriaMeses          Int                  @default(120)

  integracionErp    IntegracionErp?
  mapeosErp         MapeoErp[]
  eventosErp        EventoErp[]
  memberships       CompanyMembership[]
  requerimientos    Requerimiento[]
  contratos         Contrato[]
  disputas          Disputa[]
  matrizReglas      MatrizAprobacionRegla[]
  casosConsultor    CasoConsultor[]
  invitaciones      Invitacion[]
  auditLogs         AuditLogEntry[]
  evaluaciones      EvaluacionDesempeno[]
  unidadesNegocio   UnidadNegocio[]
  centrosCosto      CentroCosto[]
  graficasGuardadas GraficaGuardada[]

  @@map("companies")
}

model User {
  // Primary key mirrors the Supabase Auth user id (auth.users.id) — Supabase
  // owns credentials/sessions/MFA, this table only holds our app profile data.
  id                  String    @id
  nombre              String
  email               String    @unique
  portal              Portal
  role                Role
  iniciales           String
  cargo               String?
  activo              Boolean   @default(true)
  lastLoginAt         DateTime?
  createdAt           DateTime  @default(now())
  /// Null until the user explicitly accepts the Términos y Condiciones / Aviso de
  /// Privacidad — gates a one-time acceptance modal on first entry to a portal.
  terminosAceptadosEn DateTime?
  // Whether in-app notifications are also sent by email.
  recibirCorreos      Boolean   @default(true)

  memberships               CompanyMembership[]
  proveedorProfile          ProveedorProfile?
  requerimientosSolicitados Requerimiento[]       @relation("Solicitante")
  aprobacionesResueltas     Aprobacion[]          @relation("ResueltoPor")
  aprobacionPasos           AprobacionPaso[]
  notificaciones            Notificacion[]
  auditLogs                 AuditLogEntry[]
  casosConsultor            CasoConsultor[]       @relation("Consultor")
  disputasMediadas          Disputa[]             @relation("Mediador")
  mensajesDisputa           MensajeDisputa[]
  preguntasRespondidas      Pregunta[]            @relation("PreguntaRespondidoPor")
  evaluacionesRealizadas    EvaluacionDesempeno[]
  graficasGuardadas         GraficaGuardada[]

  @@map("users")
}

model CompanyMembership {
  id        String  @id @default(cuid())
  userId    String
  companyId String
  activo    Boolean @default(true)

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([userId, companyId])
  @@index([companyId])
  @@map("company_memberships")
}

// ---------------------------------------------------------------------------
// Cliente domain: requerimientos, aprobaciones, matriz
// ---------------------------------------------------------------------------

model Requerimiento {
  id                   String                 @id @default(cuid())
  // Human-readable sequential code (REQ-0001, REQ-0002, ...) shown in the UI
  // instead of the cuid — Postgres autoincrement keeps it atomic and unique
  // without any app-level counter logic.
  numero               Int                    @unique @default(autoincrement())
  companyId            String
  titulo               String
  descripcion          String?
  categoria            String
  estado               EstadoRequerimiento    @default(BORRADOR)
  prioridad            PrioridadRequerimiento @default(NORMAL)
  montoEstimado        Int
  moneda               Moneda                 @default(USD)
  centroCostoId        String?
  fechaLimite          DateTime
  progreso             Int                    @default(0)
  proveedoresInvitados Int                    @default(0)
  ofertasRecibidas     Int                    @default(0)
  solicitanteId        String
  criteriosPeso        Json?
  especificaciones     Json?
  createdAt            DateTime               @default(now())
  updatedAt            DateTime               @updatedAt

  company     Company      @relation(fields: [companyId], references: [id])
  solicitante User         @relation("Solicitante", fields: [solicitanteId], references: [id])
  centroCosto CentroCosto? @relation(fields: [centroCostoId], references: [id])

  ofertas        Oferta[]
  adjudicaciones Adjudicacion[]
  items          ItemRequerimiento[]
  aprobaciones   Aprobacion[]
  invitaciones   Invitacion[]
  comentarios    ComentarioRequerimiento[]
  documentos     DocumentoRequerimiento[]
  auctionSession AuctionSession?
  contratos      Contrato[]
  preguntas      Pregunta[]

  @@index([companyId, createdAt])
  @@index([centroCostoId])
  @@index([solicitanteId])
  @@map("requerimientos")
}

model ComentarioRequerimiento {
  id              String   @id @default(cuid())
  requerimientoId String
  autor           String
  texto           String
  createdAt       DateTime @default(now())

  requerimiento Requerimiento @relation(fields: [requerimientoId], references: [id], onDelete: Cascade)

  @@index([requerimientoId])
  @@map("comentarios_requerimiento")
}

model DocumentoRequerimiento {
  id              String          @id @default(cuid())
  requerimientoId String
  nombre          String
  estado          EstadoDocumento @default(PENDIENTE)
  createdAt       DateTime        @default(now())
  /// Path within the `requerimientos-documentos` Supabase Storage bucket, set once the file is actually uploaded.
  storagePath     String?
  /// Size reported by the uploader — counts toward the company's storage quota.
  tamanoBytes     Int?

  requerimiento Requerimiento @relation(fields: [requerimientoId], references: [id], onDelete: Cascade)

  @@index([requerimientoId])
  @@map("documentos_requerimiento")
}

model Aprobacion {
  id              String           @id @default(cuid())
  requerimientoId String
  tipo            TipoAprobacion
  monto           Int
  urgente         Boolean          @default(false)
  estado          EstadoAprobacion @default(PENDIENTE)
  motivoRechazo   String?
  resueltoPorId   String?
  resueltoAt      DateTime?
  rolesRequeridos Role[]
  tipoRegla       TipoRegla        @default(UNICA)
  pasoActual      Int              @default(0)
  createdAt       DateTime         @default(now())

  requerimiento Requerimiento    @relation(fields: [requerimientoId], references: [id], onDelete: Cascade)
  resueltoPor   User?            @relation("ResueltoPor", fields: [resueltoPorId], references: [id])
  pasos         AprobacionPaso[]

  @@index([requerimientoId])
  @@map("aprobaciones")
}

// One row per role that actually approved a step — the real audit trail behind
// Aprobacion.pasoActual. For UNICA there's exactly one row (whoever closed it
// out); for SECUENCIAL there's one per role in the chain, in order.
model AprobacionPaso {
  id            String   @id @default(cuid())
  aprobacionId  String
  rol           Role
  aprobadoPorId String
  aprobadoAt    DateTime @default(now())

  aprobacion  Aprobacion @relation(fields: [aprobacionId], references: [id], onDelete: Cascade)
  aprobadoPor User       @relation(fields: [aprobadoPorId], references: [id])

  @@index([aprobacionId])
  @@map("aprobacion_pasos")
}

model MatrizAprobacionRegla {
  id        String    @id @default(cuid())
  companyId String
  montoMin  Int
  montoMax  Int?
  roles     Role[]
  tipo      TipoRegla @default(UNICA)

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@map("matriz_aprobacion_reglas")
}

// ---------------------------------------------------------------------------
// Proveedores: directorio, homologación, ofertas
// ---------------------------------------------------------------------------

model ProveedorProfile {
  id                   String   @id @default(cuid())
  userId               String?  @unique
  nombre               String
  iniciales            String
  categorias           String[]
  score                Int      @default(0)
  ubicacion            String
  sitioWeb             String?
  // Tax id (NIT/RUT/RFC…) — how the buyer's ERP identifies the supplier.
  nit                  String?
  certificaciones      String[]
  procesosGanados      Int      @default(0)
  entregasATiempo      Int      @default(0)
  disputasCount        Int      @default(0)
  color                String
  onboardingCompletado Boolean  @default(false)
  // Denormalized from EvaluacionDesempeno (0-100), recomputed on every new
  // evaluation so directory listings don't aggregate on each request.
  desempenoPromedio    Float?
  evaluacionesCount    Int      @default(0)
  // Public showcase ("vitrina") content the proveedor manages itself.
  descripcion          String?
  telefonoContacto     String?
  emailContacto        String?
  videoUrl             String?
  vitrinaVistas        Int      @default(0)
  createdAt            DateTime @default(now())

  user            User?                 @relation(fields: [userId], references: [id])
  homologacion    Homologacion?
  ofertas         Oferta[]
  invitaciones    Invitacion[]
  pagos           PagoPO[]
  adjudicaciones  Adjudicacion[]
  contratos       Contrato[]
  disputas        Disputa[]
  preguntas       Pregunta[]
  evaluaciones    EvaluacionDesempeno[]
  archivosVitrina ArchivoVitrina[]
  itemsCatalogo   ItemCatalogo[]

  @@map("proveedor_profiles")
}

model Homologacion {
  id                  String             @id @default(cuid())
  proveedorId         String             @unique
  estado              EstadoHomologacion @default(BORRADOR)
  score               Int                @default(0)
  alertas             String[]
  fechaSolicitud      DateTime           @default(now())
  proximaRevalidacion DateTime?
  /// NIT/RUT number detected by OCR on the "RUT / NIT" document, for manual cross-check against RUES.
  nitDetectado        String?
  /// Respuestas del Cuestionario de Homologación de Proveedores (secciones 1-6 y 8),
  /// guardado como borrador editable hasta que se envía a validación. Shape: HomologacionCuestionario.
  cuestionario        Json?
  /// Desglose del score por categoría ponderada (financiero/legal/compliance/tecnico/operacional/comercial),
  /// calculado en HomologacionScoringService.evaluar(). Shape: ScoreDesglose.
  scoreDesglose       Json?
  nivelRiesgo         NivelRiesgo?
  /// Último motivo de "solicitar información" del panel de Compliance, visible al proveedor
  /// mientras la homologación está de vuelta en BORRADOR para que la corrija.
  observaciones       String?

  proveedor      ProveedorProfile        @relation(fields: [proveedorId], references: [id], onDelete: Cascade)
  documentos     DocumentoHomologacion[]
  verificaciones VerificacionLista[]

  @@index([estado])
  @@map("homologaciones")
}

model DocumentoHomologacion {
  id             String             @id @default(cuid())
  homologacionId String
  nombre         String
  categoria      CategoriaDocumento @default(LEGAL)
  // Required ones block "enviar" until uploaded; optional ones only matter
  // when a client company lists their category as required for invitation.
  obligatorio    Boolean            @default(true)
  estado         EstadoDocumento    @default(PENDIENTE)
  vigencia       DateTime?
  /// Path within the `homologacion-documentos` Supabase Storage bucket, set once a file is actually uploaded.
  storagePath    String?

  homologacion Homologacion @relation(fields: [homologacionId], references: [id], onDelete: Cascade)

  @@index([homologacionId])
  @@map("documentos_homologacion")
}

model Oferta {
  id                  String   @id @default(cuid())
  requerimientoId     String
  proveedorId         String
  precioUnitario      Int
  precioTotal         Int
  plazoEntregaDias    Int
  condicionesPagoDias Int
  garantiaMeses       Int
  vigenciaOfertaDias  Int
  calidad             Int      @default(80)
  enviada             Boolean  @default(false)
  createdAt           DateTime @default(now())

  requerimiento Requerimiento    @relation(fields: [requerimientoId], references: [id], onDelete: Cascade)
  proveedor     ProveedorProfile @relation(fields: [proveedorId], references: [id])
  // Per-line prices when the requerimiento is itemized; precioTotal is then
  // computed server-side from these (lines left out = not quoted).
  items         ItemOferta[]

  @@unique([requerimientoId, proveedorId])
  @@index([proveedorId])
  @@map("ofertas")
}

/// One line of a requerimiento's bill of quantities. A requerimiento without
/// items is quoted as a single lump sum (Oferta.precioTotal).
model ItemRequerimiento {
  id              String  @id @default(cuid())
  requerimientoId String
  orden           Int
  descripcion     String
  cantidad        Float
  unidad          String
  especificacion  String?

  requerimiento Requerimiento      @relation(fields: [requerimientoId], references: [id], onDelete: Cascade)
  precios       ItemOferta[]
  adjudicado    AdjudicacionLinea?

  @@index([requerimientoId, orden])
  @@map("items_requerimiento")
}

model ItemOferta {
  id             String @id @default(cuid())
  ofertaId       String
  itemId         String
  precioUnitario Int

  oferta Oferta            @relation(fields: [ofertaId], references: [id], onDelete: Cascade)
  item   ItemRequerimiento @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@unique([ofertaId, itemId])
  @@index([itemId])
  @@map("items_oferta")
}

/// One per awarded proveedor: an itemized requerimiento can be split across
/// several (each gets its own lines, PO and contract).
model Adjudicacion {
  id                  String   @id @default(cuid())
  requerimientoId     String
  proveedorId         String
  precioFinal         Int
  plazoDias           Int
  condicionesPagoDias Int
  garantiaMeses       Int
  poId                String
  confirmada          Boolean  @default(false)
  revisionLegal       Boolean  @default(false)
  firmado             Boolean  @default(false)
  notificarPerdedores Boolean  @default(true)
  // Set by firmar() — the contract this award produced.
  contratoId          String?  @unique
  createdAt           DateTime @default(now())

  requerimiento Requerimiento       @relation(fields: [requerimientoId], references: [id], onDelete: Cascade)
  proveedor     ProveedorProfile    @relation(fields: [proveedorId], references: [id])
  contrato      Contrato?           @relation(fields: [contratoId], references: [id])
  lineas        AdjudicacionLinea[]

  @@unique([requerimientoId, proveedorId])
  @@index([proveedorId])
  @@map("adjudicaciones")
}

model AdjudicacionLinea {
  id             String @id @default(cuid())
  adjudicacionId String
  // Unique: a line can only be awarded once.
  itemId         String @unique
  cantidad       Float
  precioUnitario Int
  subtotal       Int

  adjudicacion Adjudicacion      @relation(fields: [adjudicacionId], references: [id], onDelete: Cascade)
  item         ItemRequerimiento @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@index([adjudicacionId])
  @@map("adjudicacion_lineas")
}

// ---------------------------------------------------------------------------
// Contratos, seguimiento
// ---------------------------------------------------------------------------

model Contrato {
  id                    String         @id @default(cuid())
  // Human-readable sequential code (CTO-0001 / PO-0001 / ADD-0001, prefix
  // from `tipo`) — same pattern as Requerimiento.numero.
  numero                Int            @unique @default(autoincrement())
  companyId             String
  requerimientoId       String?
  tipo                  TipoContrato
  // Who the contract is with. Nullable only for rows that predate it.
  proveedorId           String?
  proveedorNombre       String
  categoria             String
  monto                 Int
  // Copied from the requerimiento at signing time (or from the padre for a
  // PO under a Contrato Marco) so every amount downstream has its currency.
  moneda                Moneda         @default(USD)
  // Copied from the requerimiento (or the padre) — what budget execution reads.
  centroCostoId         String?
  vigenciaInicio        DateTime
  vigenciaFin           DateTime
  estado                EstadoContrato @default(ACTIVO)
  createdAt             DateTime       @default(now())
  // When the company attaches their own PO/contract file, this points at it in
  // the `contratos-documentos` Supabase Storage bucket — null means whoever
  // downloads this contract gets the Procurex-generated template instead.
  archivoNombre         String?
  archivoStoragePath    String?
  archivoTamanoBytes    Int?
  // Set on a PO issued under a Contrato Marco (tipo CONTRATO) — links the
  // child PO back to the master agreement it was issued under.
  contratoPadreId       String?
  // Copied from the Adjudicacion at signing time so payment-on-milestone
  // (see HitoSeguimiento.porcentaje) doesn't need to reach back through
  // requerimiento → adjudicacion just to know when a generated PagoPO is due.
  condicionesPagoDias   Int            @default(30)
  // Set by the daily vencimientos cron the first time each threshold is
  // crossed, so a contract nearing expiry gets exactly one notification per
  // threshold instead of one every day the cron runs.
  recordatorio60Enviado Boolean        @default(false)
  recordatorio30Enviado Boolean        @default(false)
  recordatorio15Enviado Boolean        @default(false)
  terminadoAt           DateTime?
  motivoTerminacion     String?

  company        Company                    @relation(fields: [companyId], references: [id])
  requerimiento  Requerimiento?             @relation(fields: [requerimientoId], references: [id])
  hitos          HitoSeguimiento[]
  pagos          PagoPO[]
  padre          Contrato?                  @relation("ContratoPadreHijas", fields: [contratoPadreId], references: [id])
  hijas          Contrato[]                 @relation("ContratoPadreHijas")
  evaluaciones   EvaluacionDesempeno[]
  centroCosto    CentroCosto?               @relation(fields: [centroCostoId], references: [id])
  proveedor      ProveedorProfile?          @relation(fields: [proveedorId], references: [id])
  adjudicacion   Adjudicacion?
  modificaciones ModificacionContrato[]
  versiones      VersionDocumentoContrato[]

  @@index([companyId])
  @@index([estado])
  @@index([requerimientoId])
  @@index([proveedorId])
  @@map("contratos")
}

model HitoSeguimiento {
  id                String     @id @default(cuid())
  contratoId        String
  label             String
  comprometido      DateTime
  real              DateTime?
  estado            EstadoHito @default(PENDIENTE)
  orden             Int        @default(0)
  // % of the contrato's monto released when this hito is marked COMPLETADO —
  // moving it to COMPLETADO generates a real PagoPO for that amount.
  porcentaje        Int        @default(0)
  pagoGeneradoId    String?    @unique
  // What the proveedor reported about this milestone (delivered, progress…);
  // the buyer still decides when it's COMPLETADO.
  avanceProveedor   String?
  avanceReportadoAt DateTime?

  contrato     Contrato @relation(fields: [contratoId], references: [id], onDelete: Cascade)
  pagoGenerado PagoPO?  @relation(fields: [pagoGeneradoId], references: [id])

  @@index([contratoId])
  @@map("hitos_seguimiento")
}

/// Every change to a signed contract's terms, kept as its history (the
/// "otrosí"): extensions, amount changes and early termination.
model ModificacionContrato {
  id              String           @id @default(cuid())
  contratoId      String
  tipo            TipoModificacion
  motivo          String
  vigenciaAntes   DateTime?
  vigenciaDespues DateTime?
  montoAntes      Int?
  montoDespues    Int?
  usuario         String
  createdAt       DateTime         @default(now())

  contrato Contrato @relation(fields: [contratoId], references: [id], onDelete: Cascade)

  @@index([contratoId])
  @@map("modificaciones_contrato")
}

/// Each file the company attached to a contract; the newest is the current one.
model VersionDocumentoContrato {
  id          String   @id @default(cuid())
  contratoId  String
  nombre      String
  storagePath String
  tamanoBytes Int?
  subidoPor   String
  createdAt   DateTime @default(now())

  contrato Contrato @relation(fields: [contratoId], references: [id], onDelete: Cascade)

  @@index([contratoId, createdAt])
  @@map("versiones_documento_contrato")
}

// ---------------------------------------------------------------------------
// Disputas
// ---------------------------------------------------------------------------

model Disputa {
  id           String        @id @default(cuid())
  companyId    String
  poReferencia String
  proveedorId  String?
  severidad    Severidad     @default(MEDIA)
  estado       EstadoDisputa @default(ABIERTA)
  mediadorId   String?
  createdAt    DateTime      @default(now())
  resueltoAt   DateTime?

  company   Company           @relation(fields: [companyId], references: [id])
  proveedor ProveedorProfile? @relation(fields: [proveedorId], references: [id])
  mediador  User?             @relation("Mediador", fields: [mediadorId], references: [id])
  mensajes  MensajeDisputa[]

  @@index([companyId])
  @@map("disputas")
}

model MensajeDisputa {
  id        String   @id @default(cuid())
  disputaId String
  autorId   String?
  autor     String
  texto     String
  createdAt DateTime @default(now())

  disputa   Disputa @relation(fields: [disputaId], references: [id], onDelete: Cascade)
  autorUser User?   @relation(fields: [autorId], references: [id])

  @@index([disputaId])
  @@map("mensajes_disputa")
}

// ---------------------------------------------------------------------------
// Invitaciones, pagos
// ---------------------------------------------------------------------------

model Invitacion {
  id              String           @id @default(cuid())
  requerimientoId String?
  proveedorId     String
  companyId       String
  categoria       String
  fechaLimite     DateTime
  estado          EstadoInvitacion @default(NUEVA)
  // False while the requerimiento is still pending approval — the provider
  // shortlist chosen at creation time is preselected but not yet sent.
  // Flips to true (and the provider gets notified) once the requerimiento
  // is approved, or immediately for invitations added after approval.
  enviada         Boolean          @default(false)
  createdAt       DateTime         @default(now())

  requerimiento Requerimiento?   @relation(fields: [requerimientoId], references: [id])
  proveedor     ProveedorProfile @relation(fields: [proveedorId], references: [id])
  company       Company          @relation(fields: [companyId], references: [id])

  @@index([proveedorId])
  @@index([requerimientoId])
  @@map("invitaciones")
}

// Q&A on a licitación — a proveedor asks, whoever holds the requerimiento
// (the comprador that created it, or anyone else in the company) answers.
model Pregunta {
  id              String    @id @default(cuid())
  requerimientoId String
  proveedorId     String
  pregunta        String
  respuesta       String?
  respondidoPorId String?
  respondidoAt    DateTime?
  createdAt       DateTime  @default(now())

  requerimiento Requerimiento    @relation(fields: [requerimientoId], references: [id], onDelete: Cascade)
  proveedor     ProveedorProfile @relation(fields: [proveedorId], references: [id])
  respondidoPor User?            @relation("PreguntaRespondidoPor", fields: [respondidoPorId], references: [id])

  @@index([requerimientoId])
  @@index([proveedorId])
  @@map("preguntas")
}

model PagoPO {
  id                  String     @id @default(cuid())
  contratoId          String
  proveedorId         String
  monto               Int
  moneda              Moneda     @default(USD)
  fechaEmision        DateTime
  fechaPagoPactada    DateTime
  estado              EstadoPago @default(PENDIENTE)
  disputaAbierta      Boolean    @default(false)
  // Early-payment discount agreed through SolicitudProntoPago (0 = none).
  descuentoProntoPago Int        @default(0)
  // Filled when the buyer registers the payment.
  fechaPago           DateTime?
  montoPagado         Int?
  referenciaPago      String?
  soportePath         String?
  soporteNombre       String?
  pagadoPor           String?

  contrato              Contrato              @relation(fields: [contratoId], references: [id])
  proveedor             ProveedorProfile      @relation(fields: [proveedorId], references: [id])
  hitoOrigen            HitoSeguimiento?
  facturas              Factura[]
  solicitudesProntoPago SolicitudProntoPago[]

  @@index([proveedorId])
  @@index([contratoId])
  @@map("pagos_po")
}

/// The proveedor's invoice for a PagoPO. A rejected one stays as history and
/// a new one can be filed; at most one is RADICADA or APROBADA at a time.
model Factura {
  id            String        @id @default(cuid())
  pagoId        String
  numero        String
  fechaEmision  DateTime
  monto         Int
  archivoPath   String
  archivoNombre String
  estado        EstadoFactura @default(RADICADA)
  motivoRechazo String?
  revisadaPor   String?
  revisadaAt    DateTime?
  createdAt     DateTime      @default(now())

  pago PagoPO @relation(fields: [pagoId], references: [id], onDelete: Cascade)

  @@index([pagoId])
  @@map("facturas")
}

/// Proveedor asks to be paid before the agreed date in exchange for a discount;
/// the buyer accepts (the payment date and net amount change) or declines.
model SolicitudProntoPago {
  id             String           @id @default(cuid())
  pagoId         String
  fechaPropuesta DateTime
  descuentoPct   Float
  montoNeto      Int
  estado         EstadoProntoPago @default(SOLICITADA)
  motivo         String?
  respondidaPor  String?
  respondidaAt   DateTime?
  createdAt      DateTime         @default(now())

  pago PagoPO @relation(fields: [pagoId], references: [id], onDelete: Cascade)

  @@index([pagoId])
  @@map("solicitudes_pronto_pago")
}

// ---------------------------------------------------------------------------
// Notificaciones, auditoría
// ---------------------------------------------------------------------------

model Notificacion {
  id        String           @id @default(cuid())
  userId    String
  tipo      TipoNotificacion
  titulo    String
  desc      String
  // Portal-relative path (e.g. "/cliente/aprobaciones?highlight=xyz") the user
  // lands on when they click the notification — the deep link into the flow
  // that actually needs their attention, not just a generic list.
  link      String?
  leida     Boolean          @default(false)
  createdAt DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, leida])
  @@index([userId, createdAt])
  @@map("notificaciones")
}

model AuditLogEntry {
  id        String   @id @default(cuid())
  usuarioId String?
  usuario   String
  accion    String
  detalle   String
  motivo    String?
  createdAt DateTime @default(now())
  // Nullable only because rows written before this column existed can't be
  // backfilled reliably — every writer from here on always sets it. A cliente
  // never sees another company's rows; only Interno sees the unscoped log
  // (including legacy null-companyId rows).
  companyId String?

  usuarioUser User?    @relation(fields: [usuarioId], references: [id])
  company     Company? @relation(fields: [companyId], references: [id])

  @@index([companyId, createdAt])
  @@map("audit_log")
}

// ---------------------------------------------------------------------------
// Panel interno
// ---------------------------------------------------------------------------

model CasoConsultor {
  id          String     @id @default(cuid())
  consultorId String
  companyId   String
  tipo        String
  prioridad   Prioridad  @default(MEDIA)
  estado      EstadoCaso @default(PENDIENTE)
  slaVencido  Boolean    @default(false)
  createdAt   DateTime   @default(now())

  consultor User    @relation("Consultor", fields: [consultorId], references: [id])
  company   Company @relation(fields: [companyId], references: [id])

  @@index([consultorId])
  @@index([companyId])
  @@map("casos_consultor")
}

model BenchmarkEntry {
  id             String  @id @default(cuid())
  categoria      String
  region         String
  precioPromedio Int
  muestras       Int
  outlier        Boolean @default(false)

  @@map("benchmark_entries")
}

// ---------------------------------------------------------------------------
// Subasta / negociación en vivo (respaldo persistente del estado en vivo)
// ---------------------------------------------------------------------------

model AuctionSession {
  id              String        @id @default(cuid())
  requerimientoId String        @unique
  status          EstadoSubasta @default(INACTIVA)
  deadline        DateTime?

  requerimiento Requerimiento @relation(fields: [requerimientoId], references: [id], onDelete: Cascade)
  pujas         Puja[]

  @@map("auction_sessions")
}

model Puja {
  id              String   @id @default(cuid())
  sessionId       String
  proveedorId     String
  proveedorNombre String
  montoInicial    Int
  monto           Int
  updatedAt       DateTime @updatedAt

  session AuctionSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@unique([sessionId, proveedorId])
  @@map("pujas")
}

/// One screening of a homologación against a restrictive list. Automated
/// lists (OFAC, ONU) are written by the scoring pass; lists with no public
/// API (Procuraduría, Contraloría, Policía) start PENDIENTE_MANUAL and are
/// resolved by Compliance after checking the official site.
model VerificacionLista {
  id             String         @id @default(cuid())
  homologacionId String
  lista          String
  resultado      ResultadoLista
  detalle        String?
  verificadoPor  String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  homologacion Homologacion @relation(fields: [homologacionId], references: [id], onDelete: Cascade)

  @@unique([homologacionId, lista])
  @@map("verificaciones_lista")
}

/// Buyer's performance evaluation of a proveedor on one contrato. Each
/// criterion is 1-5; `puntaje` is their weighted average scaled to 0-100.
model EvaluacionDesempeno {
  id                 String   @id @default(cuid())
  companyId          String
  contratoId         String
  proveedorId        String
  evaluadorId        String
  calidad            Int
  plazos             Int
  servicio           Int
  hse                Int
  puntaje            Int
  comentario         String?
  requierePlanMejora Boolean  @default(false)
  createdAt          DateTime @default(now())

  company   Company          @relation(fields: [companyId], references: [id])
  contrato  Contrato         @relation(fields: [contratoId], references: [id], onDelete: Cascade)
  proveedor ProveedorProfile @relation(fields: [proveedorId], references: [id])
  evaluador User             @relation(fields: [evaluadorId], references: [id])

  @@index([proveedorId])
  @@index([contratoId])
  @@index([companyId])
  @@map("evaluaciones_desempeno")
}

/// Image or PDF (brochure / catálogo) shown on the proveedor's public
/// vitrina. Files live in the private `vitrina-proveedores` bucket and are
/// served through short-lived signed URLs.
model ArchivoVitrina {
  id          String             @id @default(cuid())
  proveedorId String
  tipo        TipoArchivoVitrina
  titulo      String
  storagePath String
  orden       Int                @default(0)
  createdAt   DateTime           @default(now())

  proveedor ProveedorProfile @relation(fields: [proveedorId], references: [id], onDelete: Cascade)

  @@index([proveedorId])
  @@map("archivos_vitrina")
}

/// One product or service in the proveedor's catalog. Also searchable from
/// the client directory, so buyers find the proveedor by what it sells.
model ItemCatalogo {
  id               String   @id @default(cuid())
  proveedorId      String
  nombre           String
  descripcion      String?
  categoria        String?
  unidad           String?
  precioReferencia Int?
  moneda           Moneda?
  imagenPath       String?
  orden            Int      @default(0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  proveedor ProveedorProfile @relation(fields: [proveedorId], references: [id], onDelete: Cascade)

  @@index([proveedorId])
  @@map("items_catalogo")
}

enum TipoUnidadNegocio {
  SEDE
  UNIDAD_NEGOCIO
}

/// A site (sede) or business unit inside a client company.
model UnidadNegocio {
  id        String            @id @default(cuid())
  companyId String
  nombre    String
  codigo    String
  tipo      TipoUnidadNegocio @default(SEDE)
  ciudad    String?
  activa    Boolean           @default(true)
  createdAt DateTime          @default(now())

  company      Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  centrosCosto CentroCosto[]

  @@unique([companyId, codigo])
  @@map("unidades_negocio")
}

/// Cost center requerimientos and contratos are charged to.
model CentroCosto {
  id              String   @id @default(cuid())
  companyId       String
  unidadNegocioId String?
  codigo          String
  nombre          String
  responsable     String?
  activo          Boolean  @default(true)
  createdAt       DateTime @default(now())

  company        Company                  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  unidadNegocio  UnidadNegocio?           @relation(fields: [unidadNegocioId], references: [id], onDelete: SetNull)
  presupuestos   PresupuestoCentroCosto[]
  requerimientos Requerimiento[]
  contratos      Contrato[]

  @@unique([companyId, codigo])
  @@index([unidadNegocioId])
  @@map("centros_costo")
}

/// Annual budget of a cost center, in one currency.
model PresupuestoCentroCosto {
  id            String   @id @default(cuid())
  centroCostoId String
  anio          Int
  monto         Int
  moneda        Moneda
  updatedAt     DateTime @updatedAt

  centroCosto CentroCosto @relation(fields: [centroCostoId], references: [id], onDelete: Cascade)

  @@unique([centroCostoId, anio])
  @@map("presupuestos_centro_costo")
}

/// A chart a CFO/admin built in Analítica (metric × dimension × chart type),
/// kept per user so it follows them across devices.
model GraficaGuardada {
  id        String   @id @default(cuid())
  companyId String
  userId    String
  titulo    String
  metrica   String
  dimension String
  tipo      String
  createdAt DateTime @default(now())

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, companyId])
  @@map("graficas_guardadas")
}

// ---------------------------------------------------------------------------
// Integración con ERP (cualquier sistema: archivo o webhook firmado)
// ---------------------------------------------------------------------------

enum ModoIntegracion {
  /// Events queue up and are downloaded as a file to import into the ERP.
  ARCHIVO
  /// Events are POSTed (signed) to the company's endpoint or middleware.
  WEBHOOK
  /// Native connector: suppliers, purchase invoices and payments are created
  /// directly in Siigo Nube through its public API.
  SIIGO
}

enum TipoEventoErp {
  PROVEEDOR
  ORDEN_COMPRA
  RECEPCION
  FACTURA
  PAGO
}

enum EstadoEventoErp {
  PENDIENTE
  ENVIADO
  ERROR
  FALLIDO
  DESCARTADO
}

enum TipoMapeoErp {
  CENTRO_COSTO
  CATEGORIA
}

model IntegracionErp {
  id                 String          @id @default(cuid())
  companyId          String          @unique
  activa             Boolean         @default(false)
  modo               ModoIntegracion @default(ARCHIVO)
  /// Free label of the ERP ("Siigo", "SAP B1"…), for the screens only.
  sistema            String?
  webhookUrl         String?
  /// HMAC signing secret, encrypted at rest (AES-256-GCM).
  secretoCifrado     String?
  /// SHA-256 of the API key the ERP uses to report payments back.
  apiKeyHash         String?
  apiKeyPrefijo      String?
  /// Which event types are queued (empty = all).
  eventos            TipoEventoErp[] @default([])
  ultimaPrueba       DateTime?
  ultimaPruebaOk     Boolean?
  ultimaPruebaMsg    String?
  /// Native connector settings (Siigo: user, document types, accounts…).
  conectorConfig     Json?
  /// Native connector access key, encrypted at rest (AES-256-GCM).
  conectorCredencial String?
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@map("integraciones_erp")
}

/// Local value → code in the ERP (cost centers, categories → GL accounts).
model MapeoErp {
  id         String       @id @default(cuid())
  companyId  String
  tipo       TipoMapeoErp
  valorLocal String
  valorErp   String

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, tipo, valorLocal])
  @@map("mapeos_erp")
}

/// Outbox: one row per business document and type, holding its latest full
/// snapshot. A change re-queues it with a higher version; the receiver
/// upserts by (tipo, entidadId), so redeliveries are harmless.
model EventoErp {
  id                String          @id @default(cuid())
  companyId         String
  tipo              TipoEventoErp
  entidadId         String
  /// Human code shown in the screens (PO-0012, factura FE-10…).
  referencia        String
  version           Int             @default(1)
  payload           Json
  estado            EstadoEventoErp @default(PENDIENTE)
  intentos          Int             @default(0)
  proximoIntento    DateTime        @default(now())
  ultimoError       String?
  /// Id the ERP answered with (e.g. its purchase-order number).
  idExterno         String?
  /// Human number in the ERP (Siigo "FC-1-73", "RP-2-10"…).
  referenciaExterna String?
  enviadoAt         DateTime?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, tipo, entidadId])
  @@index([estado, proximoIntento])
  @@index([companyId, estado])
  @@map("eventos_erp")
}
