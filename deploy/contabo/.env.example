# Copia este archivo como .env (en esta misma carpeta) y complétalo.
# Nunca lo subas al repositorio.

# --- Dominio -----------------------------------------------------------------
# Subdominio que apunta (registro A) a la IP del VPS. Caddy saca el certificado.
API_DOMAIN=api.tudominio.com
# Correo para Let's Encrypt (avisos de vencimiento del certificado).
ACME_EMAIL=tu-correo@tudominio.com

# --- Base de datos (Supabase) ---------------------------------------------------
# Project Settings → Database → Connection string → "Session pooler" (puerto 5432).
# Añade ?connection_limit=10 para no agotar las conexiones del plan.
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres?connection_limit=10

# --- Supabase (Auth y Storage) ---------------------------------------------------
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_ANON_KEY=<anon-key>
SUPABASE_SERVICE_ROLE_KEY=<service-role-key>

# --- Frontend -------------------------------------------------------------------
# URL(s) del frontend en Vercel, sin "/" final, separadas por comas.
# La primera es la pública (enlaces de correos e invitaciones).
CORS_ORIGIN=https://app.tudominio.com,https://procurex.vercel.app
APP_URL=https://app.tudominio.com

# --- Opcionales -----------------------------------------------------------------
# Correos transaccionales (Resend). Sin la llave, los correos solo quedan en el log.
RESEND_API_KEY=
EMAIL_FROM=Procurex <notificaciones@tudominio.com>
# Errores (GlitchTip/Sentry)
GLITCHTIP_DSN=
# Cifra los secretos de la integración ERP. Opcional: si falta, se deriva de
# SUPABASE_SERVICE_ROLE_KEY (cambiar cualquiera de las dos invalida los secretos
# guardados y habría que regenerarlos en Integraciones).
INTEGRACIONES_SECRET=
# Conector Siigo Nube (opcionales). Partner-Id = nombre de la app ante Siigo.
SIIGO_PARTNER_ID=Procurex
# SIIGO_API_URL=https://api.siigo.com
# "false" para no correr migraciones al arrancar (por defecto: true)
RUN_MIGRATIONS=true
